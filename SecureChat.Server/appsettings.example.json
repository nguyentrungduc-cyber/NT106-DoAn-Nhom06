{
  "ConnectionStrings": {
    "Default": "server=localhost;port=3306;database=securechat;user=root;password=YOUR_MYSQL_PASSWORD"
  },

  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "SecureChat.Server",
    "Audience": "SecureChat.Client",
    "AccessTokenMinutes": "15",
    "RefreshTokenDays": "30"
  },

  "SendGrid": {
    "ApiKey": "SG.REPLACE_WITH_YOUR_SENDGRID_API_KEY",
    "FromEmail": "no-reply@yourdomain.com",
    "FromName": "SecureChat"
  },

  "EmailSettings": {
    "SenderEmail": "no-reply@yourdomain.com",
    "SenderName": "SecureChat",
    "SenderPassword": "REPLACE_WITH_APP_PASSWORD_IF_USING_SMTP_FALLBACK"
  },

  "CorsOrigins": "http://localhost:3000",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
